const categorias = {
  investimentos: { peso: 2, temas: ["Renda fixa", "Selic", "Valuation" /* ... */] },
  fisica:        { peso: 1, temas: ["Termodinâmica", "Plasma", "Lasers" /* ... */] },
  biologia:      { peso: 1, temas: ["CRISPR", "Microbioma", "Priões" /* ... */] },
  historia:      { peso: 1, temas: ["Peste Negra", "Rota da Seda" /* ... */] },
};

function sortearCategoria() {
  const total = Object.values(categorias).reduce((s, c) => s + c.peso, 0);
  let r = Math.random() * total;
  for (const [nome, c] of Object.entries(categorias)) {
    r -= c.peso;
    if (r < 0) return nome;
  }
}
